# Server
PORT=3000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/intimation-form

# Email (optional — submissions are always saved to MongoDB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
RECIPIENT_EMAIL=harinimudaliar1503@gmail.com

# EmailJS — frontend email keys (exposed via /api/config)
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_USER_TEMPLATE_ID=template_xxxxxxx